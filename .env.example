# Which answer backend orswater.answer uses. "deterministic" (default) needs no API key
# at all -- it returns a bounded verbatim excerpt of the top retrieved ORS section, no
# model or network call. Set to "anthropic" to send retrieved sections to Claude for a
# cited natural-language answer instead; that incurs Anthropic API usage and requires a
# real ANTHROPIC_API_KEY below.
ANSWER_BACKEND=deterministic

# Anthropic API — only used when ANSWER_BACKEND=anthropic, and the only external service
# any document text is ever sent to. Leave empty to use the deterministic backend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres connection (defaults match docker-compose.yml).
DATABASE_URL=postgresql://orswater:orswater@localhost:5432/orswater
