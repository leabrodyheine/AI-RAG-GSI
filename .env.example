# Which answer backend orswater.answer uses. "deterministic" (default) needs no API key
# or model at all -- it returns a bounded verbatim excerpt of the top retrieved ORS
# section, no model or network call. "ollama" sends retrieved sections to a local Ollama
# model for a free, natural-language cited answer (requires Ollama installed and running
# -- see README). "anthropic" sends them to Claude instead for a paid, more reliable
# cited answer (requires a real ANTHROPIC_API_KEY below).
ANSWER_BACKEND=deterministic

# Ollama — only used when ANSWER_BACKEND=ollama. Document text goes to this local server,
# nowhere else. Defaults match a stock local install; only override if yours differs.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Anthropic API — only used when ANSWER_BACKEND=anthropic, and the only *external*
# service any document text is ever sent to. Leave empty to use the deterministic or
# ollama backend instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres connection (defaults match docker-compose.yml).
DATABASE_URL=postgresql://orswater:orswater@localhost:5432/orswater
